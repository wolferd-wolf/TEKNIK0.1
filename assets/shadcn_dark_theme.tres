[resource]

; ==================== THEME OVERRIDES ====================

; PanelContainer (used for inventory panels, slots)
PanelContainer/styles/panel = SubResource("sb_panel")

; Inventory/Crafting panel style variation
PanelContainer/styles/panel_inventory = SubResource("sb_panel_inventory")

; Button
Button/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
Button/colors/font_hover_color = Color(0.98, 0.98, 0.98, 1)
Button/colors/font_pressed_color = Color(0.98, 0.98, 0.98, 1)
Button/colors/font_disabled_color = Color(0.98, 0.98, 0.98, 0.65)
Button/colors/font_focus_color = Color(0.98, 0.98, 0.98, 1)
Button/styles/normal = SubResource("sb_button_normal")
Button/styles/hover = SubResource("sb_button_hover")
Button/styles/pressed = SubResource("sb_button_pressed")
Button/styles/focus = SubResource("sb_button_focus")
Button/styles/disabled = SubResource("sb_button_disabled")

; Button tier style variations (accessed via add_theme_stylebox_override("normal", theme.get_stylebox(...)))
; Tier 1 (Primary - CRAFT when valid)
Button/styles/button_primary = SubResource("sb_button_primary")
; Tier 1 (Primary - CRAFT when invalid)
Button/styles/button_primary_disabled = SubResource("sb_button_primary_disabled")
; Tier 2 (Navigation - RECIPES, BACK, CLOSE)
Button/styles/button_secondary = SubResource("sb_button_secondary")

; Label
Label/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)

; TextureRect (for slot backgrounds)
TextureRect/styles/normal = SubResource("sb_slot")

; Slot style variations (accessed via add_theme_stylebox_override("panel", theme.get_stylebox(...)))
; Empty slot
PanelContainer/styles/slot_empty = SubResource("sb_slot_empty")
; Occupied slot (has item)
PanelContainer/styles/slot_occupied = SubResource("sb_slot_occupied")
; Selected hotbar slot
PanelContainer/styles/slot_selected = SubResource("sb_slot_selected")

; LineEdit (if used)
LineEdit/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
LineEdit/colors/font_placeholder_color = Color(0.6, 0.6, 0.65, 0.8)
LineEdit/colors/caret_color = Color(0.23, 0.51, 0.96, 1)
LineEdit/colors/selection_color = Color(0.23, 0.51, 0.96, 0.3)
LineEdit/styles/normal = SubResource("sb_button_normal")
LineEdit/styles/focus = SubResource("sb_button_focus")
LineEdit/styles/read_only = SubResource("sb_button_disabled")

; HBoxContainer / VBoxContainer
HBoxContainer/constants/separation = 3
VBoxContainer/constants/separation = 3

; GridContainer
GridContainer/constants/h_separation = 8
GridContainer/constants/v_separation = 8

; ScrollContainer
ScrollContainer/styles/panel = SubResource("sb_scroll_bg")
ScrollContainer/styles/focus = SubResource("sb_button_focus")
ScrollContainer/styles/hover = SubResource("sb_button_hover")

; OptionButton (dropdown)
OptionButton/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
OptionButton/colors/font_hover_color = Color(0.98, 0.98, 0.98, 1)
OptionButton/styles/normal = SubResource("sb_button_normal")
OptionButton/styles/hover = SubResource("sb_button_hover")
OptionButton/styles/focus = SubResource("sb_button_focus")

; CheckBox
CheckBox/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
CheckBox/colors/font_hover_color = Color(0.98, 0.98, 0.98, 1)
CheckBox/colors/font_pressed_color = Color(0.98, 0.98, 0.98, 1)
CheckBox/styles/normal = SubResource("sb_button_normal")

; Slider
Slider/styles/slider = SubResource("sb_scroll_bg")
Slider/styles/grabber = SubResource("sb_scroll_grabber")
Slider/styles/grabber_highlight = SubResource("sb_scroll_grabber")
Slider/styles/grabber_pressed = SubResource("sb_scroll_grabber")

; ProgressBar
ProgressBar/styles/background = SubResource("sb_scroll_bg")
ProgressBar/styles/fill = SubResource("sb_button_hover")

; TabContainer
TabContainer/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
TabContainer/colors/font_selected_color = Color(0.98, 0.98, 0.98, 1)
TabContainer/styles/panel = SubResource("sb_panel")
TabContainer/styles/tabbar_background = SubResource("sb_button_normal")
TabContainer/styles/tab_unselected = SubResource("sb_button_normal")
TabContainer/styles/tab_selected = SubResource("sb_button_hover")
TabContainer/styles/tab_hovered = SubResource("sb_button_hover")
TabContainer/styles/tab_focus = SubResource("sb_button_focus")
TabContainer/styles/tab_disabled = SubResource("sb_button_disabled")

; ItemList
ItemList/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
ItemList/colors/font_selected_color = Color(0.98, 0.98, 0.98, 1)
ItemList/colors/guide_color = Color(0.0, 0.0, 0.0, 0.0)
ItemList/styles/panel = SubResource("sb_panel")
ItemList/styles/focus = SubResource("sb_button_focus")
ItemList/styles/hovered = SubResource("sb_button_hover")
ItemList/styles/selected = SubResource("sb_button_hover")
ItemList/styles/selected_focus = SubResource("sb_button_hover")

; Tree
Tree/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
Tree/colors/guide_color = Color(0.0, 0.0, 0.0, 0.0)
Tree/styles/panel = SubResource("sb_panel")
Tree/styles/focus = SubResource("sb_button_focus")
Tree/styles/hover = SubResource("sb_button_hover")
Tree/styles/selected = SubResource("sb_button_hover")
Tree/styles/selected_focus = SubResource("sb_button_hover")
Tree/constants/v_separation = 1
Tree/constants/draw_guides = 0
Tree/constants/draw_relationship_lines = 0

; RichTextLabel
RichTextLabel/styles/normal = SubResource("sb_panel")
RichTextLabel/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)
RichTextLabel/colors/link_color = Color(0.23, 0.51, 0.96, 1)

; Window (for dialogs/popups)
Window/styles/panel = SubResource("sb_panel")

; TabBar
TabBar/colors/font_unselected_color = Color(0.45, 0.45, 0.45, 1)
TabBar/colors/font_selected_color = Color(0.98, 0.98, 0.98, 1)
TabBar/styles/tab_unselected = SubResource("sb_button_normal")
TabBar/styles/tab_selected = SubResource("sb_button_hover")
TabBar/styles/tab_hovered = SubResource("sb_button_hover")
TabBar/styles/tab_focus = SubResource("sb_button_focus")
TabBar/styles/tab_disabled = SubResource("sb_button_disabled")

; VScrollBar / HScrollBar
VScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber")
VScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber")
VScrollBar/styles/scroll = SubResource("sb_scroll_bg")
VScrollBar/styles/scroll_focus = SubResource("sb_scroll_bg")
HScrollBar/styles/grabber = SubResource("sb_scroll_grabber")
HScrollBar/styles/grabber_highlight = SubResource("sb_scroll_grabber")
HScrollBar/styles/grabber_pressed = SubResource("sb_scroll_grabber")
HScrollBar/styles/scroll = SubResource("sb_scroll_bg")
HScrollBar/styles/scroll_focus = SubResource("sb_scroll_bg")

; Separator
HSeparator/constants/separation = 1
HSeparator/styles/separator = SubResource("sb_button_disabled")
VSeparator/constants/separation = 1
VSeparator/styles/separator = SubResource("sb_button_disabled")

; SplitContainer
SplitContainer/constants/separation = 3
SplitContainer/constants/minimum_grab_thickness = 12

; ColorPicker
ColorPicker/colors/font_color = Color(0.98, 0.98, 0.98, 0.92)

; FileDialog
FileDialog/styles/panel = SubResource("sb_panel")
