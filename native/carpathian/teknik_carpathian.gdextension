[configuration]
entry_symbol = "teknik_carpathian_library_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://native/carpathian/bin/libteknik_carpathian.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/carpathian/bin/libteknik_carpathian.linux.template_release.x86_64.so"
android.debug.arm64 = "res://native/carpathian/bin/libteknik_carpathian.android.template_debug.arm64.so"
android.release.arm64 = "res://native/carpathian/bin/libteknik_carpathian.android.template_release.arm64.so"
