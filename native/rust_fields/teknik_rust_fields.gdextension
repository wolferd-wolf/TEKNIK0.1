[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://native/rust_fields/bin/libteknik_rust_fields.so"
linux.release.x86_64 = "res://native/rust_fields/bin/libteknik_rust_fields.so"
android.debug.arm64 = "res://native/rust_fields/bin/libteknik_rust_fields.android.template_debug.arm64.so"
android.release.arm64 = "res://native/rust_fields/bin/libteknik_rust_fields.android.template_release.arm64.so"
