; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="TEKNIK 0.1"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
look_left={
"deadzone": 0.2,
"events": []
}
look_right={
"deadzone": 0.2,
"events": []
}
look_up={
"deadzone": 0.2,
"events": []
}
look_down={
"deadzone": 0.2,
"events": []
}
mine_block={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
place_block={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
select_block_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
select_block_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
select_block_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
select_block_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
