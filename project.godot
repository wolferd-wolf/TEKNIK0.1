; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="TEKNIK 0.1"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
; Chunk diagnostics are still captured, but debug stdout/file logging is allowed
; to buffer instead of forcing storage flushes on every per-chunk print.
run/flush_stdout_on_print.debug=false

[autoload]

DiagnosticLogCapture="*res://scripts/debug/diagnostic_log_capture.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=3

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
look_left={
"deadzone": 0.2,
"events": []
}
look_right={
"deadzone": 0.2,
"events": []
}
look_up={
"deadzone": 0.2,
"events": []
}
look_down={
"deadzone": 0.2,
"events": []
}
mine_block={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
place_block={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
select_hotbar_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
select_hotbar_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
select_hotbar_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
select_hotbar_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
select_hotbar_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}
select_hotbar_6={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":54)]
}
select_hotbar_7={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":55)]
}
select_hotbar_8={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":56)]
}
select_hotbar_9={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":57)]
}
hotbar_previous={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
hotbar_next={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
toggle_inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
craft_test_recipe={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":67)]
}
toggle_crafting={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}

[input_devices]

; Touch controls emit explicit InputMap actions; physical mouse input remains independent.
; Disabling emulation prevents joystick/look touches from entering the mouse-look path.
; Step 2 acceptance covers both simulated-touch boundaries and the desktop mouse regression.
pointing/emulate_mouse_from_touch=false

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
